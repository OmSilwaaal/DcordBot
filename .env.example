# ── Required ─────────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
# Optional but recommended: registers /stats /recent /filters instantly in this server
DISCORD_GUILD_ID=
STARTUP_MESSAGE=true

# Use a real RPC (Helius / QuickNode / Triton free tier). The public endpoint
# frequently rejects getTokenLargestAccounts, which blocks every signal.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
RPC_RPS=4

# Trade stream. PumpPortal only streams trades with a funded API key (≥0.02 SOL):
#   PUMPPORTAL_WS=wss://pumpportal.fun/api/data?api-key=YOUR_KEY
# Without one, trades are decoded from pump.fun's on-chain logs instead (free).
# TRADE_SOURCE = chain | pumpportal (default: pumpportal if PUMPPORTAL_WS has an api-key, else chain)
TRADE_SOURCE=
# ~40 MB/min of logs. The public endpoint is free; a metered plan (Helius free) can burn credits fast.
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
# The public endpoint drops each socket every ~30s; overlapping sockets cover the gaps
# (live test: 1 socket missed ~4% of trades, 3 sockets ~0.3%). Each adds ~40 MB/min.
SOLANA_WS_CONNECTIONS=3

# ── Tracking ─────────────────────────────────────────────
ALLOWED_POOLS=pump
WATCH_WINDOW_MIN=20
DEAD_AFTER_SEC=180
MAX_TRACKED=2000
SNIPER_WINDOW_SEC=3
TICKER_WINDOW_MIN=60

# ── Hard gates (Pct = 0–100) ─────────────────────────────
MIN_AGE_SEC=45
MIN_CURVE_PCT=8
MAX_CURVE_PCT=85
MIN_UNIQUE_BUYERS=25
MIN_BUYERS_5M=15
MIN_BUY_COUNT_PCT_5M=55
MIN_NET_FLOW_SOL_5M=2
MAX_TOP10_PCT=30
MAX_SINGLE_HOLDER_PCT=8
MAX_DEV_PCT=8
MAX_DEV_SELL_PCT=0
MAX_SNIPER_PCT=15
MAX_VOL_CONC_TOP3_PCT=50
MAX_WASH_PCT=30
MAX_DRAWDOWN_PCT=35
MAX_TICKER_DUPES=3
ONCHAIN_MAX_TOP10_PCT=35
ONCHAIN_MAX_SINGLE_HOLDER_PCT=10
REQUIRE_ONCHAIN=true
REQUIRE_RUGCHECK=false
RUGCHECK_IGNORE=lp,liquidity

MAX_CREATOR_LAUNCHES_24H=1000

# Wallet forensics (verify stage). Gates default to log-only.
WALLET_ANALYSIS=true
WALLET_SAMPLE=20
FRESH_WALLET_HOURS=24
WALLET_HISTORY_LIMIT=100
BUSY_FUNDER_TXS=1000
MAX_FRESH_WALLET_PCT=100
MAX_CLUSTER_HOLD_PCT=100
MAX_DEV_FUNDED_BUYERS=1000

# Attention
DEX_ORDERS=true
# X mentions. X_MODE = api | scrape | off (default: whichever credential is set).
# api:    official X API, pay-per-use
X_BEARER_TOKEN=
# scrape: free via rettiwt-api, logged in as an X account. Against X's terms —
#         use a THROWAWAY account; the key is equivalent to that account's login.
X_SCRAPE_API_KEY=
X_SCRAPE_PROXY=
X_MODE=
# Defaults: 20/day on the API, 150/day when scraping
X_MAX_CALLS_PER_DAY=
X_MAX_RESULTS=10

# ── Scoring ──────────────────────────────────────────────
MIN_SCORE=60
TIER_A=80
TIER_B=70
VELOCITY_TARGET=12
FLOW_TARGET_PCT=25

# ── Trade plan (shown in alerts + forward-tested) ────────
PLAN_STOP_LOSS_PCT=35
PLAN_TAKE_PROFIT_MULT=2
PLAN_TIME_STOP_MIN=60
PLAN_ENTRY_SLIPPAGE_PCT=5
PLAN_ROUND_TRIP_COST_PCT=3

MAX_SIGNALS_PER_HOUR=20
DATASET_ENABLED=true
SNAPSHOT_AGES_SEC=60,180,300
HEALTH_PORT=8080
LOG_LEVEL=info

# ── CS2 skin/knife deal alerts (read-only, never buys) ───
SKINS_ENABLED=false
SKINS_CHANNEL_ID=
SKINS_INTERVAL_MIN=5
# Net of seller fees, as a fraction (0.05 = 5%)
SKINS_MIN_NET_EDGE=0.05
SKINS_MIN_SALES_7D=3
SKINS_MIN_PRICE=20
SKINS_MAX_PRICE=2000
SKINS_KNIVES_ONLY=true
SKINS_MAX_ALERTS_PER_SCAN=5
SKINS_OUTCOME_DAYS=7
# Fee overrides (fractions) - verify monthly, sources conflict
# FEE_SKINPORT_SELL=0.08
# FEE_CSFLOAT_SELL=0.02
# FEE_CSFLOAT_CASHOUT=0.025
# FEE_STEAM_SELL=0.15

# Optional: second price check on CSFloat (free key from your CSFloat profile; never commit it)
CSFLOAT_API_KEY=
# SKINS_CHINA_BUFFER=0.1
# FEE_WAXPEER_SELL=0.06
# FEE_MARKETCSGO_SELL=0.05
# FEE_MARKETCSGO_CASHOUT=0.05
